# Public base URL of the site (used for links in emails and redirects)
APP_URL=http://localhost:3000

# Postgres connection string (append ?sslmode=require if the server demands TLS)
DIGNUM_DATABASE_URL=postgres://user:password@localhost:5432/dignum

# Absolute path of the folder holding the documents, with `public/` and `protected/` inside
FILES_DIR=/srv/dignum/files

# SMTP for outgoing mail. Port 465 uses TLS directly; any other port requires STARTTLS
# (except for localhost, so a local catcher like Mailpit on port 1025 works without TLS).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="dignum <downloads@example.com>"

# Secret for signing the session cookie (at least 32 bytes, e.g. `openssl rand -base64 32`)
SESSION_SECRET=

# Staff notification (/api/cron/notify, called hourly by a scheduler, see deploy/README.md)
# Comma-separated list of staff addresses that receive new registrations
NOTIFY_EMAILS="sales@example.com, info@example.com"
# Hours after the email confirmation before staff are notified (collects downloads in between)
NOTIFY_DELAY_HOURS=24
# Sent as bearer token to the notify route (e.g. `openssl rand -base64 32`)
CRON_SECRET=
