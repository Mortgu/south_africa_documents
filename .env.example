# Public base URL of the site (used for links in emails)
APP_URL=http://localhost:3000

# Vercel Blob (private store) — set automatically when the store is connected to the project;
# pull locally with `vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# Postgres
DATABASE_URL=

# Resend
RESEND_API_KEY=
EMAIL_FROM="dignum <downloads@example.com>"

# Secret for signing the session cookie (at least 32 bytes, e.g. `openssl rand -base64 32`)
SESSION_SECRET=
