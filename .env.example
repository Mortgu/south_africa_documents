# Public base URL of the site (used for links in emails)
APP_URL=http://localhost:3000

# S3-compatible storage (AWS, Cloudflare R2, Hetzner, ...)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Postgres
DATABASE_URL=

# Resend
RESEND_API_KEY=
EMAIL_FROM="dignum <downloads@example.com>"

# Secret for signing the session cookie (at least 32 bytes, e.g. `openssl rand -base64 32`)
SESSION_SECRET=
